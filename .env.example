# Exporte no shell ou use o arquivo .env com Docker Compose.
# Vazio usa instance/gpslogistic.db no ambiente local.
GPS_DATABASE=
# Vazio gera uma chave persistente em session.key, no diretório do SQLite.
GPS_SECRET_KEY=
# Habilite quando a aplicação for servida exclusivamente via HTTPS.
GPS_COOKIE_SECURE=0
# Use 1 somente atrás de um proxy HTTPS confiável e isolado.
GPS_TRUST_PROXY=0
# Porta publicada pelo Compose, apenas em loopback.
GPS_PORT=5050
